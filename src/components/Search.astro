---
import { defaultLang, useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  initialQuery?: string;
  lang?: Lang;
}

const { initialQuery = '', lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<div class="mx-auto w-full max-w-2xl">
  <div class="relative">
    <svg
      class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
      <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <input
      id="search-input"
      type="search"
      placeholder={lang === 'en' ? 'Search videos, comics, novels…' : '搜索短视频、漫画、小说…'}
      value={initialQuery}
      autocomplete="off"
      class="w-full rounded-2xl border border-slate-200 bg-white py-3 pl-11 pr-4 text-base shadow-sm outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-100"
    />
  </div>

  <div id="search-status" class="mt-6 text-sm text-slate-500">{t('search.hint')}</div>
  <div id="search-results" class="mt-4 space-y-3"></div>
</div>

{/*
  is:inline —— Pagefind 索引在 astro build 之后才由 CLI 生成，
  构建期该文件并不存在，因此不能交给 Rollup 打包解析，
  必须原样输出，让浏览器在运行时按绝对路径加载。
  代价：此脚本内不能使用 TypeScript 语法。
*/}
<script is:inline define:vars={{ lang, hint: t('search.hint'), searching: t('search.searching'), empty: t('search.empty') }}>
  (function () {
    var input = document.getElementById('search-input');
    var statusEl = document.getElementById('search-status');
    var resultsEl = document.getElementById('search-results');
    if (!input || !statusEl || !resultsEl) return;

    var timer = null;
    var pagefind = null;

    function loadPagefind() {
      if (!pagefind) {
        pagefind = import('/pagefind/pagefind.js');
      }
      return pagefind;
    }

    function renderResult(data) {
      var el = document.createElement('a');
      el.href = data.url;
      el.className =
        'block rounded-2xl border border-slate-200 bg-white p-4 shadow-card transition hover:border-brand-300 hover:shadow-card-hover';

      var h = document.createElement('h3');
      h.className = 'font-semibold text-slate-900';
      h.textContent = (data.meta && data.meta.title) || (lang === 'en' ? 'Untitled' : '未命名条目');

      var p = document.createElement('p');
      p.className = 'mt-1 line-clamp-2 text-sm text-slate-500';
      p.textContent = data.excerpt || '';

      el.appendChild(h);
      el.appendChild(p);
      return el;
    }

    function runSearch(term) {
      resultsEl.innerHTML = '';
      if (!term.trim()) {
        statusEl.textContent = hint;
        return;
      }

      statusEl.textContent = searching;

      loadPagefind()
        .then(function (pf) {
          // 只返回当前语种的页面，避免英文站搜出中文条目
          return pf.search(term, { excerptLength: 20, filters: { lang: lang } });
        })
        .then(function (search) {
          if (!search.results.length) {
            statusEl.textContent = lang === 'en'
              ? empty + ' (' + term + ')'
              : '没有找到与「' + term + '」相关的内容。';
            return;
          }
          statusEl.textContent =
            (lang === 'en' ? search.results.length + ' results:' : '共 ' + search.results.length + ' 条结果：');
          return Promise.all(
            search.results.map(function (r) {
              return r.data();
            })
          ).then(function (items) {
            items.forEach(function (data) {
              resultsEl.appendChild(renderResult(data));
            });
          });
        })
        .catch(function (err) {
          console.error(err);
          statusEl.textContent = lang === 'en'
            ? 'Search service failed to load. Please try again later.'
            : '搜索服务加载失败，请稍后重试。';
        });
    }

    input.addEventListener('input', function () {
      clearTimeout(timer);
      var term = input.value;
      timer = setTimeout(function () {
        runSearch(term);
      }, 250);
    });

    // 从 /search?q= 带入的初始查询
    if (input.value.trim()) {
      runSearch(input.value.trim());
    }
  })();
</script>
