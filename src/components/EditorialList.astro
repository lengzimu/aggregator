---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SeoData from './SeoData.astro';
import { useTranslations, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const all = await getCollection('editorial');
const items = all
  .filter((e) => (e.data.language ?? 'zh') === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageTitle = t('editorial.title');
const base = lang === 'en' ? '/en/editorial/' : '/editorial/';

const crumbs = [
  { name: lang === 'en' ? 'Home' : '首页', url: lang === 'en' ? '/en/' : '/' },
  { name: pageTitle, url: base },
];

const itemList = items.map((e) => ({ title: e.data.title, url: `${base}${e.slug}/` }));

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Layout title={`${pageTitle} | HubLinks`} description={t('editorial.subtitle')} lang={lang}>
  <SeoData lang={lang} crumbs={crumbs} entries={itemList} />

  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-slate-400">
      {
        crumbs.map((c, i) => (
          <>
            {i > 0 && <span class="px-1">/</span>}
            {i === crumbs.length - 1 ? (
              <span class="text-slate-600" aria-current="page">{c.name}</span>
            ) : (
              <a href={c.url} class="hover:text-brand-600">{c.name}</a>
            )}
          </>
        ))
      }
    </nav>

    <div class="mb-8">
      <h1 class="text-2xl font-bold text-slate-900">{pageTitle}</h1>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">{t('editorial.subtitle')}</p>
    </div>

    {
      items.length === 0 ? (
        <p class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500">
          {t('editorial.empty')}
        </p>
      ) : (
        <ul class="space-y-4">
          {items.map((e) => (
            <li class="rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-card">
              <a href={`${base}${e.slug}/`} class="block">
                <h2 class="text-base font-semibold text-slate-900 hover:text-brand-600">
                  {e.data.title}
                </h2>
                <p class="mt-1.5 text-sm leading-6 text-slate-600">{e.data.description}</p>
                <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-400">
                  <span>{t('editorial.published')} {fmt(e.data.pubDate)}</span>
                  {e.data.updatedDate && (
                    <span>{t('editorial.updated')} {fmt(e.data.updatedDate)}</span>
                  )}
                  <span>{e.data.entries.length} {lang === 'en' ? 'titles' : '部作品'}</span>
                </div>
                {e.data.tags.length > 0 && (
                  <div class="mt-2 flex flex-wrap gap-1">
                    {e.data.tags.map((tag) => (
                      <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[11px] text-slate-500">{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Layout>
