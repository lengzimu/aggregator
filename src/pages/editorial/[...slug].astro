---
import { getCollection } from 'astro:content';
import EditorialArticle from '../../components/EditorialArticle.astro';

export async function getStaticPaths() {
  const all = await getCollection('editorial');
  return all
    .filter((e) => (e.data.language ?? 'zh') === 'zh')
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<EditorialArticle lang="zh" entry={entry} />
