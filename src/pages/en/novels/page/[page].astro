---
import { getCollection } from 'astro:content';
import ListView from '../../../../components/ListView.astro';
import { PAGE_SIZE } from '../../../../lib/content.ts';

export async function getStaticPaths() {
  const all = await getCollection('novels');
  const total = all.filter((e) => (e.data.language ?? 'zh') === 'en').length;
  const pages = Math.ceil(total / PAGE_SIZE);
  // 第 1 页就是 /novels/，这里只生成第 2 页起
  return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2 },
  }));
}

const { page } = Astro.props;
---

<ListView lang="en" type="novels" page={page} />
