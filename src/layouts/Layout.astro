---
import '../styles/global.css';
import SeoData from '../components/SeoData.astro';
import {
  defaultLang,
  localizedPath,
  switchLanguagePath,
  useTranslations,
  type Lang,
} from '../i18n/ui.ts';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
  /** 本页在两种语言下的路径（相对站点根）。用于自动推导无法保证存在的对应页时手动兜底。 */
  alternates?: { zh: string; en: string };
}

const {
  title,
  description,
  lang = defaultLang,
  ogImage = '/default-cover.svg',
  alternates,
  alternatePath,
} = Astro.props;

const t = useTranslations(lang);
const isEn = lang === 'en';

const defaultDescription = isEn
  ? 'Discover trending short videos, comics and novels — curated links to official platforms.'
  : '发现热门短视频、漫画与小说——精选直达正版平台的链接。';
const pageDescription = description ?? defaultDescription;

const siteUrl = Astro.site ?? new URL('https://example.com');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();

// hreflang 必须双向互链：每个页面都声明 全部语种版本 + x-default（指向默认语种 zh）
//
// 默认用 switchLanguagePath 从当前 pathname 推导，但并非每种语言都存在同一页面
// （例如 /comics/platform/kuaikan/ 在英文站没有对应页，因为英文条目里没有快看）。
// hreflang 指向 404 会让 Google 忽略整组标注，所以允许调用方显式指定，
// 或退回到「该分类列表页」这类一定存在的等价页。
const zhPath = alternates?.zh ?? (alternatePath ? localizedPath(alternatePath, 'zh') : switchLanguagePath(Astro.url.pathname, 'zh'));
const enPath = alternates?.en ?? (alternatePath ? localizedPath(alternatePath, 'en') : switchLanguagePath(Astro.url.pathname, 'en'));

const zhHref = new URL(zhPath, siteUrl).toString();
const enHref = new URL(enPath, siteUrl).toString();
const xDefaultHref = zhHref; // 默认语种为 zh（根路径），未指定语种时回退到这里

const otherLang: Lang = isEn ? 'zh' : 'en';

const nav = [
  { label: t('nav.videos'), href: localizedPath('/videos/', lang) },
  { label: t('nav.comics'), href: localizedPath('/comics/', lang) },
  { label: t('nav.novels'), href: localizedPath('/novels/', lang) },
  { label: t('nav.editorial'), href: localizedPath('/editorial/', lang) },
  { label: t('nav.about'), href: localizedPath('/about/', lang) },
];
const pathname = Astro.url.pathname;

const htmlLang = isEn ? 'en' : 'zh-CN';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Google AdSense 加载脚本：仅配置了 PUBLIC_ADSENSE_CLIENT 才注入（手动插槽模式）；
        Ezoic 等平台自动注入方案无需此处脚本 */}
    {
      import.meta.env.PUBLIC_ADSENSE_CLIENT && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* 搜索引擎站长验证（可选，配了 PUBLIC_* 才输出，缺省不渲染） */}
    {
      import.meta.env.PUBLIC_GSC_VERIFICATION && (
        <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_VERIFICATION} />
      )
    }
    {
      import.meta.env.PUBLIC_BING_VERIFICATION && (
        <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_VERIFICATION} />
      )
    }

    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={isEn ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 antialiased">
    <SeoData lang={lang} />

    <!-- 语种过滤器：让 Pagefind 能把中/英页面分开检索 -->
    <span class="sr-only" data-pagefind-filter="lang">{lang}</span>

    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:px-6">
        <a href={localizedPath('/', lang)} class="flex shrink-0 items-center gap-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-600 text-white">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M4 6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Z"
                fill="currentColor"
                opacity=".85"></path>
              <path
                d="M14 14a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2v-2Z"
                fill="currentColor"></path>
              <path
                d="M14 4a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1V4Z"
                fill="currentColor"
                opacity=".6"></path>
              <path
                d="M4 14a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3Z"
                fill="currentColor"
                opacity=".6"></path>
              <path
                d="M6 10h12M12 6v12"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                opacity=".5"></path>
            </svg>
          </span>
          <span class="text-lg font-bold tracking-tight">HubLinks</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                  pathname.startsWith(item.href)
                    ? 'bg-brand-50 text-brand-700'
                    : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <form
          action={localizedPath('/search/', lang)}
          method="get"
          class="ml-auto flex min-w-0 flex-1 justify-end sm:flex-none"
        >
          <label class="relative w-full max-w-xs">
            <span class="sr-only">{t('nav.search')}</span>
            <svg
              class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
              <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            </svg>
            <input
              type="search"
              name="q"
              placeholder={t('nav.searchPlaceholder')}
              class="w-full rounded-full border border-slate-200 bg-slate-50 py-2 pl-9 pr-4 text-sm outline-none transition-colors focus:border-brand-400 focus:bg-white focus:ring-2 focus:ring-brand-100"
            />
          </label>
        </form>

        <a
          href={otherLang === 'en' ? enPath : zhPath}
          class="shrink-0 rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:border-brand-300 hover:text-brand-700"
          hreflang={otherLang}
        >
          {otherLang === 'en' ? 'EN' : '中文'}
        </a>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <div class="mb-3 flex items-center gap-2">
              <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-600 text-white">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M4 6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Z"></path>
                  <path d="M14 14a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2v-2Z"></path>
                </svg>
              </span>
              <span class="font-bold">HubLinks</span>
            </div>
            <p class="text-sm leading-6 text-slate-500">{t('footer.about')}</p>
          </div>

          <div>
            <h3 class="mb-3 text-sm font-semibold text-slate-900">{t('footer.browse')}</h3>
            <ul class="space-y-2 text-sm text-slate-600">
              <li><a href={localizedPath('/videos/', lang)} class="hover:text-brand-600">{t('nav.videos')}</a></li>
              <li><a href={localizedPath('/comics/', lang)} class="hover:text-brand-600">{t('nav.comics')}</a></li>
              <li><a href={localizedPath('/novels/', lang)} class="hover:text-brand-600">{t('nav.novels')}</a></li>
              <li><a href={localizedPath('/editorial/', lang)} class="hover:text-brand-600">{t('nav.editorial')}</a></li>
              <li><a href={localizedPath('/search/', lang)} class="hover:text-brand-600">{t('nav.search')}</a></li>
            </ul>
          </div>

          <div>
            <h3 class="mb-3 text-sm font-semibold text-slate-900">{t('footer.site')}</h3>
            <ul class="space-y-2 text-sm text-slate-600">
              <li><a href={localizedPath('/about/', lang)} class="hover:text-brand-600">{t('footer.aboutUs')}</a></li>
              <li><a href={localizedPath('/editorial-policy/', lang)} class="hover:text-brand-600">{t('nav.editorialPolicy')}</a></li>
              <li><a href={localizedPath('/disclaimer/', lang)} class="hover:text-brand-600">{t('footer.disclaimer')}</a></li>
              <li><a href={localizedPath('/privacy/', lang)} class="hover:text-brand-600">{t('footer.privacy')}</a></li>
              <li><a href={localizedPath('/dmca/', lang)} class="hover:text-brand-600">{t('footer.dmca')}</a></li>
            </ul>
          </div>

          <div>
            <h3 class="mb-3 text-sm font-semibold text-slate-900">{t('footer.affiliate')}</h3>
            <p class="text-sm leading-6 text-slate-500">{t('footer.affiliateDesc')}</p>
          </div>
        </div>

        <div class="mt-10 border-t border-slate-100 pt-6 text-center text-xs text-slate-400">
          © {new Date().getFullYear()} HubLinks · {t('footer.rights')}
        </div>
      </div>
    </footer>
  </body>
</html>
