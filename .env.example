# ===== DMCA 下架端点（可选，覆盖默认 /api/dmca） =====
# PUBLIC_DMCA_ENDPOINT=/api/dmca

# ===== DMCA 兜底工单（未配置下架后端时，打开预填 GitHub Issue） =====
# PUBLIC_DMCA_REPO=owner/repo

# ===== DMCA 直接下架（Cloudflare Pages 环境变量，需保密） =====
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# GITHUB_REPO=owner/repo

# ===== Cloudflare Turnstile CAPTCHA（可选，配置即生效，缺省则跳过） =====
# PUBLIC_TURNSTILE_SITE_KEY=0x4XXXXXXXxxxxxxxxxxxx
# TURNSTILE_SECRET_KEY=0x4XXXXXXXxxxxxxxxxxxx

# ===== IP 频率限制（Cloudflare Pages 环境变量，需先绑定 RATE_LIMIT_KV 命名空间才生效） =====
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_SEC=3600

# ===== 站点级配置（构建期读取，PUBLIC_ 前缀会暴露到前端） =====
# PUBLIC_SITE_URL=https://your-domain.com
# PUBLIC_AFFILIATE_URL=https://www.amazon.com/?tag=YOUR-TAG-20
# PUBLIC_AFFILIATE_LABEL=Amazon Associates
# PUBLIC_DMCA_EMAIL=dmca@your-domain.com

# ===== 搜索引擎站长验证（可选，配了才在 <head> 输出对应 meta 标签） =====
# Google Search Console 验证字符串（在 GSC 添加资源后获取）
# PUBLIC_GSC_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bing Webmaster Tools 验证字符串（Bing 已并入indexNow/必应站长平台）
# PUBLIC_BING_VERIFICATION=xxxxxxxxxxxxxxxx

# ===== 广告（可选；未配置则广告位显示中性占位框，布局不塌陷） =====
# Google AdSense 手动插槽模式：填发布商 ID 与插槽 ID 才生效
# PUBLIC_ADSENSE_CLIENT=ca-pub-1234567890123456
# PUBLIC_ADSENSE_SLOT=1234567890
# 注：Ezoic 等平台自动注入方案无需此处变量，把站点加入 Ezoic 并切换 DNS 即可。
